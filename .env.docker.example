# Variáveis usadas pelo docker-compose.yml
# Copie como `.env` e ajuste o que precisar.

# Postgres (container local)
POSTGRES_USER=efficiencia
POSTGRES_PASSWORD=efficiencia
POSTGRES_DB=efficiencia

# Frontend
FRONTEND_URL=http://localhost:8080
VITE_API_URL=http://localhost:3001

# Auth
JWT_SECRET=cole-aqui-um-segredo-gerado-com-openssl-rand-hex-32
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=

# n8n
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://n8n:5678/webhook/assist-bpmn
N8N_TIMEOUT_MS=60000
TZ=America/Sao_Paulo

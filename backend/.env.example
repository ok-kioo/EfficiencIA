# Porta do servidor Express
PORT=3001

# Origem do frontend liberada no CORS
FRONTEND_URL=http://localhost:5173

# Connection string Postgres (use a string do Supabase: Project Settings → Database)
# Use o Supavisor pooler (IPv4). O host direto db.<ref>.supabase.co é IPv6-only.
# Session pooler (5432) recomendado para migrations; Transaction pooler (6543) para a app.
DATABASE_URL=postgresql://postgres.<project-ref>:<SENHA>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Opcional: força IPv4 caso ainda use host direto
PG_FORCE_IPV4=true

# Segredo para assinar JWTs (gere algo longo e aleatório)
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=7d

# Google OAuth — Client ID do console.cloud.google.com
GOOGLE_CLIENT_ID=

# Endpoint do agente de IA no n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook/assist-bpmn
N8N_TIMEOUT_MS=60000
